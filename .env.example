# 楽天ウェブサービス (https://webservice.rakuten.co.jp/) で発行したアプリID・アクセスキー
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# 取得対象のジャンルID(カンマ区切りで複数指定可、空なら0=総合ランキング)
RAKUTEN_GENRE_IDS=0

# Claude API キー (投稿文生成用)。未設定の場合はテンプレート文で代用します
ANTHROPIC_API_KEY=

# Instagram Graph API (Meta for Developers で発行)
IG_USER_ID=
IG_ACCESS_TOKEN=
